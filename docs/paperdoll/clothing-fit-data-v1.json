  "construction": {
    "first": "Render completed garment overlay separately on each 64x160 male/female original body, independent of hair/head.",
    "second": "Fit both shoulder seams, sleeve directions and actual skin exit point; inspect hands and arm occlusion.",
    "third": "Only after full-on-body fitting, split each into transparent front core, screen-left sleeve, screen-right sleeve.",
    "fourth": "Use same 64x160 native coordinate space for every layer, without cropping/recentering/stretching.",
    "fifth": "Recompose with underlying body + underwear and approved cloak; preserve original male and female poses.",
    "last": "Only promote to formal game assets after user visually approves the iPhone preview.",
    "layerNames": [
      "core",
      "leftSleeve",
      "rightSleeve"
    ],
    "frontOnly": true,
    "backViewRequired": false,
    "renderOrder": [
      "cloakBack(if equipped)",
      "characterBody",
      "baseUnderwear",
      "shorts",
      "shirtLeftSleeve",
      "shirtRightSleeve",
      "shirtFrontCore",
      "cloakFront(if equipped)",
      "exposedForearmsAndHandsMasked",
      "faceAndHair"
    ],
    "sleeveGuidance": "Cuff edge should be approximately perpendicular to the outgoing arm direction; left and right have consistent visual length, but do not force mirror symmetry.",
    "avoid": [
      "back-facing shirt panels",
      "solid backing inside neckline",
      "double dark outlines at shoulder seams",
      "sleeve painting that changes original arm pose",
      "one gender shirt scaled to other gender",
      "hard rectangular arm masks cutting through torso",
      "autoscale or center each component independently"
    ]
  },
